# Copy to .env and point SECRETS_PATH_FILE at it (settings.py reads that file):
#   cp .env.example .env && export SECRETS_PATH_FILE=$PWD/.env
# Values below match docker-compose.yml.

# ---- Django ----
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGIN_ALLOW_ALL=True
CORS_ORIGIN_WHITELIST=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO

# ---- PostgreSQL ----
DATABASE_URL=postgres://kadabra:kadabra@localhost:5432/kadabra

# ---- Redis / Celery ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_DB_RES=1
CELERY_BROKER_URL=redis://localhost:6379/0

# ---- Elasticsearch ----
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PWD=
ELASTICSEARCH_VERIFY_CERTS=False
ELASTICSEARCH_NUM_SHARDS=1
# 0 on a single node (docker-compose); 1+ on a cluster.
ELASTICSEARCH_NUM_REPLICAS=0
# float | byte (byte = int8 vectors, 4x smaller; text and poster indices only)
ELASTICSEARCH_VECTOR_ELEMENT_TYPE=float
# e.g. int8_hnsw on Elasticsearch versions that support it (8.8 does not)
ELASTICSEARCH_VECTOR_INDEX_TYPE=

# ---- Search models ----
# use-large | minilm | minilm-multilingual  (change => rebuild_indices movies --reembed)
TEXT_EMBEDDING_MODEL=use-large
PRELOAD_NLP_MODEL=False
INDEX_MOVIE_PASSAGES=False
INDEX_MOVIE_POSTERS=False

# ---- External APIs ----
IMDBID_APIKEY=

# ---- Telegram bot ----
BOT_TOKEN=
BOT_USER_NAME=
BOT_URL=https://your-domain.example/bot/webhook/
BOT_SECRET_TOKEN=change-me-too
